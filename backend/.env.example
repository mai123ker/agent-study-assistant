# 复制成 .env 后使用：cp .env.example .env
#
# 默认全离线可跑：LLM_PROVIDER=mock + EMBEDDING_PROVIDER=hash
# 想接真实模型：把 LLM_PROVIDER 改成 openai 并填 LLM_API_KEY（见文件末尾说明）

# ==================== 运行模式 ====================
# mock   : 本地模拟回复，不联网（默认，用来验证链路）
# openai : 调用 OpenAI 兼容接口
LLM_PROVIDER=mock

# ==================== LLM 接口（PROVIDER=openai 时生效）====================
# DeepSeek   : https://api.deepseek.com/v1
# 阿里云百炼  : https://dashscope.aliyuncs.com/compatible-mode/v1   ← 每模型 100 万 Token 免费
# 智谱 GLM   : https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama : http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3

# ==================== 超时与重试（Day 19）====================
# 连接超时和读超时分开：TCP 握手不通就是不通，模型生成本来就慢
CONNECT_TIMEOUT=5
REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8

# ==================== 会话与 Agent ====================
MEMORY_MAX_TURNS=10
AGENT_MAX_STEPS=8

# ==================== RAG ====================
RAG_ENABLED=true
RAG_TOP_K=3
RAG_FETCH_K=10
CHUNK_SIZE=400
CHUNK_OVERLAP=50
# fixed | recursive | semantic
CHUNK_STRATEGY=recursive

# ---- Embedding ----
# hash  : 离线确定性伪向量，**只用于测试**，没有语义能力
# api   : 走 OpenAI 兼容 /embeddings（通义 text-embedding-v3 等）
# local : sentence-transformers 本地模型（需 pip install sentence-transformers）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=256

# ---- 向量库 ----
# memory : 纯 Python 内存实现，零依赖（开发/演示够用）
# chroma : ChromaDB 持久化（需 pip install chromadb）
VECTOR_BACKEND=memory
VECTOR_COLLECTION=study_docs

# ---- 检索 ----
# vector | bm25 | hybrid
RETRIEVAL_MODE=hybrid

# ==================== 工具安全（Day 20）====================
# read_file 只能读这个目录内的文件，防止路径穿越
TOOL_ALLOW_DIR=./data/docs

# ==================== 服务 ====================
APP_VERSION=0.2.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# 接真实模型的完整步骤（推荐用阿里云百炼，一个 key 调多家模型）
# ============================================================================
# 1. 注册 https://bailian.console.aliyun.com/ 并实名，创建 API Key
# 2. 把上面的 LLM_PROVIDER 改成 openai，LLM_API_KEY 填上你的 key
# 3. 想用真实语义检索，把 EMBEDDING_PROVIDER 改成 api
#    （text-embedding-v3 与 LLM 共用同一个 key，会自动复用）
# 4. 重启服务 —— 配置是启动时读取的，改完必须重启
#
# 只改 LLM 不改 EMBEDDING 也可以：hash 向量能跑通流程，
# 但检索质量差（它不懂语义），只适合先验证链路。
